# Credenciais do app no portal developers.bb.com.br
BB_CLIENT_ID=seu-client-id
BB_CLIENT_SECRET=seu-client-secret
BB_DEVELOPER_KEY=sua-developer-application-key

# URLs padrão do BB (ajuste se o produto no portal indicar caminhos diferentes)
